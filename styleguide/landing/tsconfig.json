{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": false
  },
  "include": ["pages", "src", "stories", "zfb.config.ts", "zudo-sg.config.mjs"],
  "exclude": ["src/generated/**/*.js"]
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@takazudo/zfb/zudo-react",
    "skipLibCheck": false,
    "types": [
      "vite/client",
      "node"
    ],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "paths": {
      "@takazudo/zfb/zudo-react": [
        "./node_modules/@takazudo/zfb/dist/zudo-react/index"
      ],
      "@takazudo/zfb/zudo-react/*": [
        "./node_modules/@takazudo/zfb/dist/zudo-react/*"
      ]
    }
  },
  "include": [
    "preview",
    "stories",
    "scripts/*.ts"
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zudo-composer",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./doc/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "zudo-composer.zudolab.dev",
      "custom_domain": true
    }
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zudo-composer-demo-blog",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./packages/demo-blog/dist-site",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "demo-blog.zudolab.dev",
      "custom_domain": true
    }
  ]
}

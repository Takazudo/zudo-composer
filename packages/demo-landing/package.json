{
  "name": "demo-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Demo Landing: a host project authored with zudo-composer and its own component pack.",
  "exports": {
    "./components": "./components/pack.ts"
  },
  "scripts": {
    "dev": "zudo-composer dev",
    "generate": "zudo-composer generate",
    "seed": "zudo-composer assets import images-src/manifest.json && zudo-composer seed",
    "build:site": "pnpm -w demo:build-site landing",
    "test": "pnpm -w test packages/demo-landing"
  },
  "devDependencies": {
    "@zudo-composer/component-contract": "workspace:*",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.6.6",
    "zudo-composer": "workspace:*"
  }
}

    "test": "vitest run"
  },
  "devDependencies": {
    "@takazudo/zfb": "7.2.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.4.0",
    "@zudo-composer/component-contract": "workspace:*",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11",
    "zudo-composer": "workspace:*"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

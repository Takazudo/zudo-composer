    "scripts/check-dist-artifact.mjs",
    "scripts/check-headless-boundary.mjs",
    "scripts/check-package-conformance.mjs",
    "scripts/check-provider-boundary.mjs",
    "scripts/check-public-types.mjs",
    "scripts/check-site-project-boundary.mjs",
    "scripts/check-standalone-handoff.mjs",
    "scripts/routes.mjs",
    "scripts/seed-demo-assets.ts",
    "scripts/run-dev-browser.mjs",
    "scripts/run-host-browser.mjs",
    "scripts/run-site-project-browser.mjs",
    "scripts/run-hosted-demo-browser.mjs",
    "scripts/run-demos-browser.mjs",
    "scripts/hosted-demo/static-server.mjs",
    "scripts/smoke-host-install.mjs",
    "scripts/verify-contract-install.mjs",
    "scripts/hosted-demo/artifact.mjs",
    "scripts/hosted-demo/deploy.mjs",
    "scripts/hosted-demo/live-check.mjs",
    "scripts/hosted-demo/workflow-guard.mjs",
    "server/site-build/artifact.mjs",
    "server/site-build/assets.ts",
    "server/site-build/run.mjs",
    "server/cli/run.mjs",
    "server/cli/build-site-entry.mjs",
    "server/site-build/print-routes.ts",
    "scripts/build-public-entries.mjs",
    "scripts/verify-public-install.mjs",
    "scripts/check-site-static.mjs",
    "scripts/build-site-static.mjs",
    "scripts/boundary-source.d.mts"
  ],
  "include": ["scripts/__tests__/**/*.ts"]
}

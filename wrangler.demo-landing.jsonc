{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zc-demo-landing",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./packages/demo-landing/dist-site",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "zc-demo-landing.zudolab.dev",
      "custom_domain": true
    }
  ]
}
